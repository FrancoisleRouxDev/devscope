# =============================================================================
# .gitattributes — consistent line endings across Windows, macOS and Linux
# =============================================================================
# Without this, Windows checkouts with core.autocrlf=true turn LF into CRLF.
# That breaks shell scripts and creates noisy diffs, and it would make the
# scanner's line-count fixtures differ per OS.

# Default: normalise text files to LF in the repo and in working copies.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never touch.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.woff2 binary

# Lockfiles: collapse in diffs and don't attempt textual merges.
Cargo.lock        linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
uv.lock           linguist-generated=true -diff
