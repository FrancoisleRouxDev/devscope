{
  "name": "devscope-dashboard",
  "productName": "devscope",
  "version": "0.1.0",
  "description": "devscope desktop app — Electron shell + Svelte dashboard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite build && electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wait-on": "^9.5.0"
  }
}
